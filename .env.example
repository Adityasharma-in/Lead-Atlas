# Copy this file to .env and fill in your own Supabase project settings.
# .env is gitignored. Real environment variables win over the file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional local server settings.
# PORT=4317
# HOST=127.0.0.1

# Optional: turn off the one-click self-updater. Vercel sets this automatically.
# SELF_UPDATE=off

# Optional: only needed for a private GitHub repository or higher API rate limits.
# GITHUB_TOKEN=
